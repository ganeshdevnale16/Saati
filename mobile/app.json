{
  "expo": {
    "name": "Saathi",
    "slug": "saathi-devnale",
    "owner": "ganesh.devnale16",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F7C7E"
    },
    "extra": {
      "apiUrl": "https://saati.onrender.com",
      "company": "Devnale Globals",
      "eas": {
        "projectId": "34fcd6df-43d6-49a0-ad09-4a8ea023118d"
      }
    },
    "ios": {
      "bundleIdentifier": "com.devnaleglobals.saathi",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Saathi uses your location to share it with people you choose.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Saathi keeps sharing your location with people you chose, even when the app is closed, until the share ends or you stop it.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.devnaleglobals.saathi",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F7C7E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Saathi keeps sharing your location with people you chose, even when the app is closed, until the share ends or you stop it."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F7C7E"
        }
      ],
      "expo-secure-store"
    ]
  }
}