PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/saathi
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d
CORS_ORIGIN=*
# true = OTP is returned in API response & logged (for testing only). Set false in production.
OTP_DEV_MODE=true
# SMS provider for OTP in production: msg91 | twilio | none
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
AUTO_MIGRATE=true
# Days to keep raw location history (data-retention policy)
LOCATION_RETENTION_DAYS=90
# ---- App download ----
# Where the Android APK lives (GitHub Release asset URL recommended). Leave empty to serve web/downloads/saathi.apk
APK_URL=
APP_VERSION=1.0.0
APK_SIZE_MB=
PLAY_STORE_URL=
IOS_URL=
APP_MIN_VERSION=
APP_RELEASE_NOTES=
# Long random secret for /api/admin tools (broadcast, stats)
ADMIN_KEY=
